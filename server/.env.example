# ─── Server ────────────────────────────────────────────────────────────────
# Local development defaults. Copy this file to server/.env.
NODE_ENV=development
PORT=3001

# Browser app origin. Add comma-separated origins if needed.
# Production requires exact HTTPS origins without paths or trailing slashes.
CLIENT_ORIGIN=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────
# Local development/tests use SQLite. Production must use Turso Cloud.
DATABASE_URL=./data/dev.sqlite
# Required together in production; never leave both blank on the deployed API.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Local developer login ─────────────────────────────────────────────────
# Enables the Continue as Local Developer button instead of Discord OAuth.
# Only works with NODE_ENV=development. Never enable this in production.
DEV_AUTH_BYPASS=true

# ─── Discord application / bot ──────────────────────────────────────────────
# Optional for local UI development with Local Developer login.
# Production requires DISCORD_APPLICATION_ID and DISCORD_BOT_TOKEN.
# DISCORD_PUBLIC_KEY is needed only when using Discord's public HTTP interaction endpoint.
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=

# ─── Discord OAuth (optional locally with DEV_AUTH_BYPASS=true) ────────────
# Production requires DISCORD_CLIENT_ID (or the application ID) and the secret.
# DISCORD_CLIENT_ID can be omitted if it matches DISCORD_APPLICATION_ID.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback

# ─── Access control ────────────────────────────────────────────────────────
# Must match VITE_ADMIN_API_KEY in client/.env and ADMIN_API_KEY in bot/.env.
# Development default only. Use a unique secret outside local development.
ADMIN_API_KEY=dev-admin-key
# Local development may fall back to ADMIN_API_KEY. Production requires a
# separate random secret of at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional one-time compatibility window for existing ADMIN_API_KEY-signed
# sessions. Set to an ISO-8601 UTC timestamp no more than 24 hours ahead.
# Only tokens issued before (cutoff - 24 hours) are accepted, preventing new
# ADMIN_API_KEY-signed sessions after the migration starts. Leave blank to
# invalidate old sessions immediately and require users to sign in again.
SESSION_LEGACY_ADMIN_KEY_UNTIL=
# Optional locally; required in production to encrypt stored bot tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── Security tuning (optional) ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ─── Staff system (optional) ───────────────────────────────────────────────
LOG_CHANNEL_ID=
# Comma-separated Discord user IDs treated as owners. The Design Lab owner must be listed here in production.
# Additional Design Lab editors are managed from /design by the owner and stored in the database.
OWNER_DISCORD_IDS=
