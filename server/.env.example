# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Where the browser SPA is served from. Comma-separate multiple origins.
CLIENT_ORIGIN=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────
# Relative paths are resolved from the `server/` directory.
# Swap for a Postgres URL later once the repository layer is pointed at `pg`.
DATABASE_URL=./data/dev.sqlite

# ─── Discord ───────────────────────────────────────────────────────────────
# Developer Portal → your application → General Information → Public Key.
# Used to verify every interaction signature.
DISCORD_PUBLIC_KEY=

# Developer Portal → your application → General Information → Application ID.
DISCORD_APPLICATION_ID=

# Developer Portal → Bot → Token. NEVER expose this to the frontend.
DISCORD_BOT_TOKEN=

# Discord Developer Portal -> OAuth2 -> General -> Client Information.
# DISCORD_CLIENT_ID may be omitted when DISCORD_APPLICATION_ID is the same ID.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a Redirect URL registered in the Discord Developer Portal.
# Production example: https://your-api-domain.example.com/api/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback

# ─── Access control ────────────────────────────────────────────────────────
# Shared secret the client sends (x-admin-key) to call privileged endpoints.
# Production must use a unique, high-entropy value; the server rejects the development default.
ADMIN_API_KEY=dev-admin-key
# Separate session-signing key. Set a random 32-byte+ value in production.
SESSION_SECRET=

# Dedicated key used to encrypt bot tokens at rest (AES-256-GCM).
# Required in production; use a random 32-byte+ value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── Security tuning (optional) ────────────────────────────────────────────
# Requests per window against /api/* before a 429 is returned.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ─── Staff System ──────────────────────────────────────────────────────────
LOG_CHANNEL_ID=
OWNER_DISCORD_IDS=
