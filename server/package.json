{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "Express API + Discord interaction endpoint for the message builder.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/config/migrate.ts",
    "benchmark": "node --expose-gc --import tsx benchmarks/runner.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dmb/shared": "*",
    "better-sqlite3": "^13.2.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "discord-interactions": "^4.4.0",
    "dotenv": "^18.0.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22 <27"
  }
}
