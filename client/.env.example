# ─── API connection ────────────────────────────────────────────────────────
# Leave EMPTY locally: Vite proxies /api to http://127.0.0.1:3001.
# Set a full URL only when the API is hosted on a different origin.
VITE_API_BASE_URL=

# ─── Local development API key ──────────────────────────────────────────────
# Must match ADMIN_API_KEY in server/.env.
# Exposed in the browser bundle; ONLY use this for local development.
# The client sends it only while running Vite in development mode.
VITE_ADMIN_API_KEY=dev-admin-key

# Optional fallback Discord staff ID for local testing without a session.
# Usually leave empty; the Local Developer session takes precedence.
VITE_STAFF_DISCORD_ID=
