# ─── Gateway worker ────────────────────────────────────────────────────────
# Copy to bot/.env only if you want to run the Discord gateway bot.
# The website (client + API) runs without this file or a bot token.
NODE_ENV=development

# Developer Portal → Bot → Token. Same token used by server/.env.
# Required for the bot worker, NOT for local UI testing. Keep it secret.
DISCORD_BOT_TOKEN=

# Express API address. The bot relays interactions to this API.
# HTTP loopback is allowed in production when bot and API share a host.
API_BASE_URL=http://127.0.0.1:3001

# Optional client origin; defaults to http://localhost:5173.
# Set this only when a non-default client origin is needed.
# CLIENT_ORIGIN=

# Must exactly match ADMIN_API_KEY in server/.env.
ADMIN_API_KEY=dev-admin-key

# Discord user IDs allowed to run privileged slash commands (/send, /exploit, /sync).
# Falls back to OWNER_DISCORD_IDS. If empty, these commands are denied to everyone.
BOT_COMMAND_ADMIN_IDS=

# Optional. Register slash commands only in this test guild for faster updates.
# Leave empty to use global command registration.
DEV_GUILD_ID=

# Optional Discord.js REST metadata.
# DISCORD_APPLICATION_ID=
